# Copy this file to .env and fill in your values

# Flask secret key (any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Business timezone (Houston area = America/Chicago)
TIMEZONE=America/Chicago

# Weekly same-weekend pickup cutoff (local TIMEZONE, America/Chicago = CST/CDT)
# After this instant, same-week Fri/Sat are greyed out on the calendar.
# Cookies can still be ordered anytime for a future weekend.
# Wednesday=2
CUTOFF_WEEKDAY=2
CUTOFF_HOUR=23
CUTOFF_MINUTE=59
# How many weeks of Fri/Sat slots to offer
PICKUP_WEEKS_AHEAD=8

# Cookie prices in cents
# Individual cookie = $4.00, build-your-own 6-pack = $20.00
PRICE_INDIVIDUAL_CENTS=400
PRICE_SIX_PACK_CENTS=2000

# Optional flat delivery fee in cents (0 = free / no extra charge)
DELIVERY_FEE_CENTS=0

# ── Stripe (required for card payments + email receipts) ──
# 1. Create account: https://dashboard.stripe.com
# 2. Developers → API keys → copy Publishable + Secret (start with test keys)
# 3. Enable automatic receipts: Settings → Business → Customer emails
#    → turn on "Successful payments"
# Required — card payment is due at checkout. Leave blank and the order form cannot submit.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin alerts when an order is paid
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phone app push (same secret typed in SCC Admin settings)
PUSH_REGISTER_SECRET=
# Path to Firebase service-account JSON on the server
FIREBASE_CREDENTIALS=

# Public site URL used in Stripe return links (no trailing slash)
# Local: http://127.0.0.1:5000
# Live:  https://www.scratchcookiecottage.com
PUBLIC_BASE_URL=http://127.0.0.1:5000

# ── Printify merch (always available; fulfilled by Printify) ──
PRINTIFY_SHOP_URL=https://scratchcookiecottage.printify.me/

# Optional deeper API integration (products / submit orders to Printify)
# Get a Personal Access Token: https://printify.com/app/account/api
# Shop ID is in your Printify shop URL / settings
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Content factory Drive (share the drop folder + shots doc with the service account)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Or paste the JSON in one line:
# GOOGLE_SERVICE_ACCOUNT_JSON=
FACTORY_SECRET=
FACTORY_DRIVE_DROP_FOLDER_ID=1U9G8Ajl5yfXHlzpwLd9iKY1M6tMEBRGl
FACTORY_SHOTS_DOC_ID=1QbKiuTuagaNv37k0xSvkWJdsfuP-0iFcXnhRkteI8ec
